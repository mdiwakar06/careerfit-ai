# ==============================================================================
# CareerFit AI — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Provider Configuration (At least ONE is recommended for live AI responses)
# If no keys are provided, CareerFit AI automatically operates in High-Fidelity
# deterministic evaluation mode for offline / zero-config testing.
# ------------------------------------------------------------------------------

# Google Gemini API (Recommended: Gemini 2.5 Flash)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API (Access to Claude 3.5 Sonnet, GPT-4o, Llama 3.3, etc.)
# Obtain from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI Direct API (Optional fallback)
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL & pgvector Configuration (For cloud persistence & RAG)
# Obtain from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
# ------------------------------------------------------------------------------

# Public project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service Role Secret Key (Server-side only — DO NOT expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 3. Hugging Face Inference API (Optional: for open-source vector embeddings)
# Obtain from: https://huggingface.co/settings/tokens
# ------------------------------------------------------------------------------
HUGGINGFACE_API_TOKEN=hf_...
